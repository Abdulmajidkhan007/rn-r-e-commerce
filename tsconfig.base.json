{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "paths": {
      "@kidswear/auth": ["./packages/auth/src/index.ts"],
      "@kidswear/core": ["./packages/core/src/index.ts"],
      "@kidswear/firebase": ["./packages/firebase/src/index.ts"],
      "@kidswear/store": ["./packages/store/src/index.ts"],
      "@kidswear/i18n": ["./packages/i18n/src/index.ts"],
      "@kidswear/theme": ["./packages/theme/src/index.ts"],
      "@kidswear/utils": ["./packages/utils/src/index.ts"],
      "@kidswear/config": ["./packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".expo", ".turbo", "build"]
}
