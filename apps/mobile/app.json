{
  "expo": {
    "name": "KidsWear",
    "slug": "kidswear",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "kidswear",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#fffaf8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ff5a3c"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow KidsWear to use Face ID to unlock your account."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KidsWear to access your photos to set product/profile images.",
          "cameraPermission": "Allow KidsWear to use the camera to take product/profile photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff5a3c"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ff5a3c",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
