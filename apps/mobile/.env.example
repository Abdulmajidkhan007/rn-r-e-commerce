# Firebase mobile config. RN_PUBLIC_* vars are inlined into the client bundle
# at build time by babel (not secrets, but keep real values out of git).
# Copy to .env and fill in.
RN_PUBLIC_FIREBASE_API_KEY=your-api-key
RN_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
RN_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
RN_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
RN_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
RN_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
RN_PUBLIC_FIREBASE_MEASUREMENT_ID=
# UX-only: highlights the admin account. Real admin authority is the Firebase
# custom claim (role:'admin'), set out-of-band via scripts/set-admin-claim.ts.
RN_PUBLIC_ADMIN_EMAIL=

# Google OAuth Web client ID.
# Obtain from: Firebase Console → Project Settings → General → "Your apps".
# Native sign-in exchanges this for a Firebase credential; the Android client
# is read from google-services.json, so no separate Android/iOS id is needed.
RN_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Payment gateways (optional) ---
# A provider is offered at checkout only when its ids are set. These are public
# merchant identifiers; the keys that authorize webhook callbacks are Cloud
# Functions secrets (PAYME_MERCHANT_KEY / CLICK_SECRET_KEY), never shipped here.
RN_PUBLIC_PAYME_MERCHANT_ID=
RN_PUBLIC_PAYME_ACCOUNT_FIELD=
RN_PUBLIC_CLICK_MERCHANT_ID=
RN_PUBLIC_CLICK_SERVICE_ID=
