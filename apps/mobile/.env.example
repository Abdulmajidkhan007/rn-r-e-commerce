# Firebase mobile config. EXPO_PUBLIC_* vars are inlined into the client bundle
# (not secrets, but keep real values out of git). Copy to .env and fill in.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# UX-only: highlights the admin account. Real admin authority is the Firebase
# custom claim (role:'admin'), set out-of-band via scripts/set-admin-claim.ts.
EXPO_PUBLIC_ADMIN_EMAIL=

