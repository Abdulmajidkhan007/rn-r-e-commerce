# Firebase web config (client-side; these are not secrets but keep real values out of git).
# Copy to .env and fill with your Firebase project's web app values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
# UX-only: highlights the admin account in the UI. Real admin authority is the
# Firebase custom claim (role:'admin'), set out-of-band via scripts/set-admin-claim.ts.
VITE_ADMIN_EMAIL=
# Web Push (FCM): "Web Push certificates" public key from
# Firebase Console > Project Settings > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

