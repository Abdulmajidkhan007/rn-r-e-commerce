# Firebase web config (client-side; these are not secrets but keep real values out of git).
# Copy to .env and fill with your Firebase project's web app values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
# UX-only: highlights the admin account in the UI. Real admin authority is the
# Firebase custom claim (role:'admin'), set out-of-band via scripts/set-admin-claim.ts.
VITE_ADMIN_EMAIL=
# Web Push (FCM): "Web Push certificates" public key from
# Firebase Console > Project Settings > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=


# --- Payment gateways (optional) ---
# A provider is offered at checkout only when its ids are set. These are public
# merchant identifiers; the keys that authorize webhook callbacks are Cloud
# Functions secrets (PAYME_MERCHANT_KEY / CLICK_SECRET_KEY), never shipped here.
VITE_PAYME_MERCHANT_ID=
# Account field name from the Payme cabinet; defaults to order_id.
VITE_PAYME_ACCOUNT_FIELD=
# Sandbox override, e.g. https://test.paycom.uz
VITE_PAYME_CHECKOUT_URL=

VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=
VITE_CLICK_CHECKOUT_URL=
