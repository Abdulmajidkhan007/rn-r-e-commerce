{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@kidswear/auth": ["../../packages/auth/src/index.ts"],
      "@kidswear/core": ["../../packages/core/src/index.ts"],
      "@kidswear/data": ["../../packages/data/src/index.ts"],
      "@kidswear/firebase": ["../../packages/firebase/src/index.ts"],
      "@kidswear/store": ["../../packages/store/src/index.ts"],
      "@kidswear/i18n": ["../../packages/i18n/src/index.ts"],
      "@kidswear/theme": ["../../packages/theme/src/index.ts"],
      "@kidswear/utils": ["../../packages/utils/src/index.ts"],
      "@kidswear/config": ["../../packages/config/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
