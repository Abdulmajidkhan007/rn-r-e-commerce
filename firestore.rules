rules_version = '2';

// KidsWear Firestore security rules (server-side source of truth).
// Phase 1: authored, NOT deployed yet.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Categories: public read; admin-only writes.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public read; admin-only writes.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: a signed-in user creates their own order in a valid initial state
    // (deposit_paid must have paidAmount == depositAmount; pending must be
    // unpaid). Owners/admins read. Admins update freely; an owner may ONLY
    // cancel a pending/deposit_paid order (status-only change). Never deleted.
    match /orders/{orderId} {
      // A client may only create an order it has not paid for (status
      // 'pending'), or one settled by the in-app mock gateway. Hosted gateways
      // (payme/click) confirm server-side: their orders must start 'pending'
      // and are flipped by the webhook, which runs with admin credentials and
      // bypasses these rules. Without this, a client could POST itself a
      // 'deposit_paid' order and claim a Payme payment that never happened.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'deposit_paid']
        && (request.resource.data.status == 'deposit_paid'
              ? request.resource.data.paidAmount == request.resource.data.depositAmount
                  && request.resource.data.payment.provider == 'mock'
              : request.resource.data.paidAmount == 0)
        && request.resource.data.keys().hasAll(
              ['items', 'subtotal', 'depositAmount', 'total', 'shippingAddress']);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && resource.data.status in ['pending', 'deposit_paid']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt']));
      allow delete: if false;
    }

    // Users: owners and admins may read. Owners may create/update their own
    // profile; non-admins may not change their role, and must start as
    // 'customer' on create. Profiles are never deleted.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && (request.resource.data.role == 'customer' || isAdmin());
      allow update: if isOwner(uid)
        && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if false;
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
