rules_version = '2';

// KidsWear Firestore security rules (server-side source of truth).
// Deployed by .github/workflows/deploy.yml. Tests: test/rules/ (emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Order money checks -------------------------------------------------
    // Mirror @kidswear/core evaluatePromo / deliveryFeeFor and
    // @kidswear/utils computeOrderTotals. The client computes, the rules
    // re-compute: a hand-written order cannot invent a discount or skip
    // delivery. (Line prices — including a variant's own price — are still
    // client-supplied; server-side repricing needs Cloud Functions; see
    // docs/REJA.md.)
    function discountOf(d) {
      return ('discount' in d) ? d.discount : 0;
    }

    function feeOf(d) {
      return ('deliveryFee' in d) ? d.deliveryFee : 0;
    }

    function promoOk(d) {
      return !('promoCode' in d)
        ? discountOf(d) == 0
        : exists(/databases/$(database)/documents/promoCodes/$(d.promoCode))
          && promoDiscountOk(get(/databases/$(database)/documents/promoCodes/$(d.promoCode)).data, d);
    }

    function promoDiscountOk(p, d) {
      return p.active == true
        && (!('expiresAt' in p) || p.expiresAt > request.time.toMillis())
        && d.subtotal >= p.minSubtotal
        && d.discount == (p.type == 'percent'
              ? math.floor(d.subtotal * p.value / 100)
              // No math.min in the rules language.
              : (p.value < d.subtotal ? p.value : d.subtotal));
    }

    function deliveryOk(d) {
      return !exists(/databases/$(database)/documents/settings/delivery)
        ? feeOf(d) == 0
        : feeOf(d) == expectedFee(get(/databases/$(database)/documents/settings/delivery).data, d);
    }

    function expectedFee(s, d) {
      return (s.freeFrom > 0 && d.subtotal - discountOf(d) >= s.freeFrom)
        ? 0
        : s.regions.get(d.shippingAddress.region, s.defaultFee);
    }

    // settings/delivery.minOrder: smallest subtotal (after discount) accepted.
    // Mirrors @kidswear/core minOrderShortfall. Same document as deliveryOk,
    // so the get() is served from the per-request cache.
    function minOrderOk(d) {
      return !exists(/databases/$(database)/documents/settings/delivery)
        || d.subtotal - discountOf(d)
             >= get(/databases/$(database)/documents/settings/delivery).data.get('minOrder', 0);
    }

    function totalsOk(d) {
      return d.total == d.subtotal - discountOf(d) + feeOf(d)
        && d.depositAmount == math.round(d.total * 0.5);
    }

    function providerOf(d) {
      return d.get('payment', {}).get('provider', '');
    }

    // Card transfer orders are accepted only while settings/payment has it on.
    function transferOk(d) {
      return providerOf(d) != 'transfer'
        || (exists(/databases/$(database)/documents/settings/payment)
            && get(/databases/$(database)/documents/settings/payment).data.transferEnabled == true);
    }

    function sizeBetween(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    // Categories: public read; admin-only writes.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public read; admin-only writes. That covers `variants` too:
    // per size × colour stock/price is only ever written by an admin, and the
    // admin mutation keeps `stock` equal to the variants' sum.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product photos while the project has no Storage bucket (Spark): one
    // compressed JPEG per document, referenced from products as `kwimg:<id>`.
    // 420000 = INLINE_IMAGE_MAX_DATA_URL_CHARS in @kidswear/utils — keeps the
    // document far below Firestore's 1 MiB limit. Immutable once written:
    // clients cache an id's bytes forever, so a new photo gets a new id.
    match /productImages/{imageId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['productId', 'dataUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 420000
        && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Orders: a signed-in user creates their own order in a valid initial state
    // (deposit_paid must have paidAmount == depositAmount; pending must be
    // unpaid). Owners/admins read. Admins update (status changes go through a
    // client transaction that also moves stock — see changeOrderStatus); an
    // owner may ONLY cancel a still-pending order. Never deleted.
    match /orders/{orderId} {
      // A client may only create an order it has not paid for (status
      // 'pending'), or one settled by the in-app mock gateway. Hosted gateways
      // (payme/click) confirm server-side: their orders must start 'pending'
      // and are flipped by the webhook, which runs with admin credentials and
      // bypasses these rules. Without this, a client could POST itself a
      // 'deposit_paid' order and claim a Payme payment that never happened.
      // `stockApplied` belongs to the stock transaction: an order created
      // with it would never have its stock taken.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'deposit_paid']
        && (request.resource.data.status == 'deposit_paid'
              ? request.resource.data.paidAmount == request.resource.data.depositAmount
                  && request.resource.data.payment.provider == 'mock'
              : request.resource.data.paidAmount == 0)
        && request.resource.data.keys().hasAll(
              ['items', 'subtotal', 'depositAmount', 'total', 'shippingAddress'])
        && !('stockApplied' in request.resource.data)
        && !('cancelReason' in request.resource.data)
        && transferOk(request.resource.data)
        && promoOk(request.resource.data)
        && deliveryOk(request.resource.data)
        && minOrderOk(request.resource.data)
        && totalsOk(request.resource.data);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Owner cancel: pending only (nothing paid, no stock taken), and only
      // status + cancelReason ('customer') + updatedAt may change.
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelReason == 'customer'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelReason', 'updatedAt']));
      allow delete: if false;
    }

    // Card-transfer receipts (Spark, no Storage): one compressed JPEG per
    // document, ids are slots {orderId}_r1…_r5 — a create never overwrites, so
    // that is the per-order cap. Only the order's owner creates one, and only
    // for their own still-pending `transfer` order; owner and admins read.
    // Customers never change or delete a receipt (so they cannot approve
    // their own). An admin reviews a pending receipt once: only status,
    // reviewedBy, reviewedAt and note change. Approval flips the order to
    // deposit_paid in the same client transaction (reviewReceipt); the order
    // rule already lets only admins do that.
    match /receipts/{receiptId} {
      function receiptOrderPath(d) {
        return /databases/$(database)/documents/orders/$(d.orderId);
      }

      function receiptSlotOk(d) {
        return receiptId in [d.orderId + '_r1', d.orderId + '_r2', d.orderId + '_r3',
                             d.orderId + '_r4', d.orderId + '_r5'];
      }

      function ownPendingTransferOrder(d) {
        return exists(receiptOrderPath(d))
          && get(receiptOrderPath(d)).data.userId == request.auth.uid
          && get(receiptOrderPath(d)).data.status == 'pending'
          && providerOf(get(receiptOrderPath(d)).data) == 'transfer';
      }

      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'userId', 'data', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && sizeBetween(request.resource.data.orderId, 1, 200)
        && receiptSlotOk(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 420000
        && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && ownPendingTransferOrder(request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (!('note' in request.resource.data) || sizeBetween(request.resource.data.note, 1, 500));
      allow delete: if false;
    }

    // Stock journal: append-only, admin-only. Written in the same transaction
    // as the product stock change it records; never edited or deleted, so the
    // history cannot be rewritten after the fact.
    match /stockMoves/{moveId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['productId', 'variantId', 'delta', 'reason', 'orderId', 'note', 'by', 'createdAt'])
        && sizeBetween(request.resource.data.productId, 1, 200)
        && sizeBetween(request.resource.data.variantId, 1, 400)
        && request.resource.data.delta is int
        && request.resource.data.delta != 0
        && request.resource.data.reason in ['sale', 'return', 'intake', 'writeoff', 'inventory']
        && (!('orderId' in request.resource.data) || sizeBetween(request.resource.data.orderId, 1, 200))
        && (!('note' in request.resource.data) || sizeBetween(request.resource.data.note, 1, 500))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Users: owners and admins may read. Owners may create/update their own
    // profile; non-admins may not change their role, and must start as
    // 'customer' on create. Profiles are never deleted.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && (request.resource.data.role == 'customer' || isAdmin());
      allow update: if isOwner(uid)
        && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if false;
    }

    // Favorites: a private list per user; the doc id is the product id.
    match /users/{uid}/favorites/{productId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
        && request.resource.data.productId == productId;
    }

    // Contact form: anyone may write one message of a bounded shape; only
    // admins read it. No server rate limit without Functions — the size caps
    // keep abuse cheap to clean up.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'phone', 'email', 'message', 'status', 'userId', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'new'
        && sizeBetween(request.resource.data.name, 1, 80)
        && sizeBetween(request.resource.data.phone, 1, 30)
        && sizeBetween(request.resource.data.message, 5, 2000)
        && (!('email' in request.resource.data) || sizeBetween(request.resource.data.email, 3, 120))
        && (!('userId' in request.resource.data)
              || (isSignedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Blog: published posts are public; drafts are admin-only.
    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Promo codes: a customer may look one up by exact code, never list them.
    match /promoCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Store settings (delivery prices): public read, admin write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
